# Copy to .env, fill in, then `chmod 600 .env`.
MEDIA_DOMAIN=media.example.com
MEDIA_PUBLIC_IP=203.0.113.5
# The image tag the rest of the instance runs (0.1.0, or sha-1234abc).
FUWA_VERSION=
# A key for media calls only (`openssl rand -hex 32`), also set as
# FUWA_MEDIA_KEY on the directory and every shard. Not the cluster key.
FUWA_MEDIA_KEY=
FUWA_REGION=
